{
  "uid": "shop-chaos",
  "title": "shop — хаос подов",
  "tags": [
    "shop",
    "lab5"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Клиент: провалено за период",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "round(sum(increase(shop_client_requests_total{namespace=\"shop\",result=\"fail\"}[$__range])))",
          "legendFormat": "",
          "range": false,
          "instant": true
        }
      ],
      "description": "Все неуспешные запросы клиента (таймаут, connection refused, не 201) за выбранный интервал",
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Клиент: успешно за период",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "round(sum(increase(shop_client_requests_total{namespace=\"shop\",result=\"ok\"}[$__range])))",
          "legendFormat": "",
          "range": false,
          "instant": true
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Новых подов api/worker за период",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "count(count by (pod) (last_over_time(kube_pod_info{namespace=\"shop\",pod=~\"(api|worker)-.*\"}[$__range]))) - count(kube_pod_info{namespace=\"shop\",pod=~\"(api|worker)-.*\"})",
          "legendFormat": "",
          "range": false,
          "instant": true
        }
      ],
      "description": "Сколько подов появилось и исчезло за интервал: все когда-либо виденные минус живые сейчас",
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Новых IP подов за период",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "count(count by (pod_ip) (last_over_time(kube_pod_info{namespace=\"shop\",pod=~\"(api|worker)-.*\"}[$__range]))) - count(count by (pod_ip) (kube_pod_info{namespace=\"shop\",pod=~\"(api|worker)-.*\"}))",
          "legendFormat": "",
          "range": false,
          "instant": true
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Клиент → api.shop.svc.cluster.local: запросы/с",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(rate(shop_client_requests_total{namespace=\"shop\",result=\"ok\"}[30s]))",
          "legendFormat": "ok",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "sum by (reason) (rate(shop_client_requests_total{namespace=\"shop\",result=\"fail\"}[30s]))",
          "legendFormat": "fail: {{reason}}",
          "range": true,
          "instant": false
        }
      ],
      "description": "Клиент ходит по DNS-имени Service, каждый запрос — новое TCP-соединение",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ok"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "fail.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Под капотом: поды api/worker умирают и появляются",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "count by (app) (label_replace(count by (pod) (count_over_time(kube_pod_info{namespace=\"shop\",pod=~\"(api|worker)-.*\"}[1m])), \"app\", \"$1\", \"pod\", \"(api|worker)-.*\"))",
          "legendFormat": "{{app}}: разных подов за 1 мин",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "count(count by (pod_ip) (count_over_time(kube_pod_info{namespace=\"shop\",pod=~\"(api|worker)-.*\"}[1m])))",
          "legendFormat": "разных IP за 1 мин",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "sum(kube_pod_status_ready{namespace=\"shop\",pod=~\"api-.*\",condition=\"true\"})",
          "legendFormat": "api: Ready сейчас",
          "range": true,
          "instant": false
        }
      ],
      "description": "api — 4 реплики, worker — 2. Значение выше числа реплик = за минуту поды сменились",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Клиент: задержка",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(shop_client_request_duration_seconds_bucket{namespace=\"shop\"}[30s])))",
          "legendFormat": "p50",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(shop_client_request_duration_seconds_bucket{namespace=\"shop\"}[30s])))",
          "legendFormat": "p99",
          "range": true,
          "instant": false
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}